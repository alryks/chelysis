{
  "name": "chelysis",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build",
    "start": "bun run --cwd frontend start",
    "test": "bun test packages/chess/tests frontend/tests",
    "typecheck": "bun run --cwd frontend typecheck && bunx tsc -p packages/chess/tsconfig.json --noEmit",
    "lint": "bun run --cwd frontend lint"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@chelysis/chess": "workspace:*"
  }
}
